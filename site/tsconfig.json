{
  // The `.mjs` modules are in here so TypeScript infers their shape from the
  // literals rather than handing the page an `any`: `examples`, `copy`, and the
  // snippet maps are the contract between this project and `scripts/sync-readme.mjs`
  // at the repository root, and a stale key in one of them should not typecheck.
  // `checkJs` stays off, so they are read for their types and not checked as
  // source; they run under bare node, where none of this applies.
  "include": ["**/*.ts", "**/*.tsx", "*.mjs"],
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // No `worker-configuration.d.ts`: it is generated by `wrangler types`,
    // gitignored, and describes an `Env` this Worker never reads, so naming it
    // here fails typechecking on every fresh clone and in CI.
    "types": ["node", "vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
