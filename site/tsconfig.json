{
  // `cli-deps.mjs` is the last JavaScript here, and stays that way because it is
  // the one file that runs on the deploy path, under whichever Node Cloudflare
  // provides. It is in the program so its shape is inferred rather than assumed;
  // `checkJs` stays off, so it is read for its types and not checked as source.
  "include": ["**/*.ts", "**/*.tsx", "cli-deps.mjs"],
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // No `worker-configuration.d.ts`: it is generated by `wrangler types`,
    // gitignored, and describes an `Env` this Worker never reads, so naming it
    // here fails typechecking on every fresh clone and in CI.
    "types": ["node", "vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
