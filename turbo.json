{
  "$schema": "./node_modules/turbo/schema.json",
  // Single-package mode: the three projects here keep their own installs and
  // their own lockfiles, so turbo has one package to look at and every task
  // below is a script in the root `package.json`. The `site:` and `talk:`
  // tasks shell into the other two projects, which is what lets one command
  // run every gate in this repository without merging three dependency trees
  // into one. See docs/decisions/2026-08-25-one-command-three-installs.md.
  //
  // Streamed rather than the interactive TUI, because this output is read by
  // agents as often as by people and a redrawn terminal replays as noise.
  "ui": "stream",
  "tasks": {
    "build": {
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    // `packaging.test.ts` skips itself when `dist/` is absent, so a test run
    // that has not built is a quieter suite rather than a failing one.
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "tests/**",
        "fixtures/**",
        "scripts/**",
        "guide/**",
        "schema/**",
        "site/cli-reference.ts",
        "site/code-samples.ts",
        "README.md",
        "package.json",
        "tsconfig.json"
      ]
    },
    "lint": {
      "inputs": [
        "src/**",
        "tests/**",
        "evals/**",
        "scripts/**",
        "site/cli-reference.ts",
        "site/code-samples.ts",
        ".oxlintrc.json",
        "package.json",
        "tsconfig.json",
        "tsconfig.check.json"
      ]
    },
    "check-types": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "site/cli-reference.ts",
        "site/code-samples.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.check.json"
      ]
    },
    // One formatter for the whole repository, run from the root. Its ignore
    // list in `.oxfmtrc.json` is what decides the real scope; naming the
    // directories again here would be a second copy of it to keep in step.
    "format": {
      "inputs": ["src/**", "tests/**", "evals/**", "scripts/**", "site/**", ".oxfmtrc.json"]
    },
    "site:lint": {
      "inputs": ["site/**"]
    },
    "site:check-types": {
      "inputs": ["site/**"]
    },
    // The page's command reference is real CLI output, generated by running the
    // CLI out of this checkout, so `src/` is an input to the site's build.
    "site:build": {
      "inputs": ["site/**", "src/**", "package.json"],
      "outputs": ["site/dist/**"]
    },
    // `interactive` is what lets the TUI hand a keypress to the server that has
    // focus, which both of these have something to do with: vite takes `r` to
    // reload, slidev takes `o` to open the deck.
    "site:dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "talk:dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
