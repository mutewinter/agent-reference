{
  "name": "fixture-npm-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fixture-npm-workspace",
      "workspaces": ["apps/*", "packages/*"]
    },
    "apps/web": {
      "name": "@mono/web",
      "dependencies": {
        "@mono/shared": "*",
        "react": "^18.2.0"
      }
    },
    "node_modules/@mono/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/react": {
      "version": "18.2.0",
      "resolved": "https://registry.npmjs.org/react/-/react-18.2.0.tgz",
      "integrity": "sha512-react"
    },
    "packages/shared": {
      "name": "@mono/shared",
      "version": "1.0.0"
    }
  }
}
